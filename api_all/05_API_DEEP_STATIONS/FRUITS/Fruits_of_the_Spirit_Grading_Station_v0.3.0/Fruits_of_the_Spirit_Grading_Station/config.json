    {
      "name": "deepseek",
      "api_kind": "chat_completions",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "model_env": "FRUITS_DEEPSEEK_MODEL",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.1,
      "max_output_tokens": 12000,
      "output_token_parameter": "max_tokens"

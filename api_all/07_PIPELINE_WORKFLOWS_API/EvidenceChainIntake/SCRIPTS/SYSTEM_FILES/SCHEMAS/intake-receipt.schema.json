{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Chain Intake Receipt",
  "type": "object",
  "required": ["title", "inferred_type", "routing_confidence", "source_sha256", "source_file"],
  "properties": {
    "title": {"type": "string"},
    "inferred_type": {"type": "string"},
    "routing_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_file": {"type": "string"},
    "canon_status": {"const": "candidate_draft"},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
